# Local-only Docker stack settings. Copy this file to .env and replace the
# four secret placeholders with long random hexadecimal values.
POSTGRES_USER=smarthome_owner
POSTGRES_PASSWORD=replace_with_random_hex
POSTGRES_DB=smarthome
POSTGRES_PORT=5433

APP_DB_PASSWORD=replace_with_random_hex
IOT_DB_PASSWORD=replace_with_random_hex
JWT_SECRET=replace_with_random_hex
JWT_EXPIRES_IN=15m

WEB_PORT=8080
MAILPIT_UI_PORT=8025
SMTP_FROM=Smart Home <noreply@smarthome.local>
